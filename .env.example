# Copy to .env for local development. Never commit the populated .env file.
NODE_ENV=development
PORT=5000
DATA_DIR=./data
APP_URL=http://localhost:5000

# Authentication. Production refuses to start unless AUTH_ENABLED=true and
# SESSION_SECRET contains at least 32 characters.
AUTH_ENABLED=true
SESSION_SECRET=replace-with-at-least-32-random-characters
ADMIN_EMAIL=admin@example.com
# Required only when the admin row does not exist yet, or during an intentional
# ADMIN_RESET_PASSWORD=true recovery. Use 12+ characters and remove it after use.
ADMIN_INITIAL_PASSWORD=replace-with-a-temporary-12-plus-character-password
ADMIN_RESET_PASSWORD=false

# Audit and enrichment services. OpenAI is preferred when both keys exist;
# set LLM_PROVIDER explicitly to "openai" or "anthropic" to override.
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
ANTHROPIC_API_KEY=sk-ant-placeholder
ANTHROPIC_MODEL=claude-sonnet-4-6
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
SERPER_API_KEY=
MANUS_API_KEY=

# Optional Keysearch browser automation.
KEYSEARCH_AUTOFETCH_ENABLED=false
KEYSEARCH_EMAIL=
KEYSEARCH_PASSWORD=
TWOCAPTCHA_API_KEY=
PROXY_URL=

# Server-side ElevenLabs voiceover generation. Create a restricted service
# account key with Text to Speech permission only. The key is never sent to the
# browser. Only voice IDs in this JSON allowlist appear in the UI.
ELEVENLABS_API_KEY=
ELEVENLABS_APPROVED_VOICES_JSON='[{"id":"UFPKgXaO1YZylfGuGr3z","name":"DJ-3"}]'
ELEVENLABS_MODEL_ID=eleven_v3
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128

# Optional override if the bundled narration template is stored elsewhere.
ELEVENLABS_TEMPLATE_PATH=
